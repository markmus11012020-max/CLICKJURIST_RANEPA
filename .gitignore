# ============================================================
# ClickJurist Production — .gitignore
# ============================================================

# --- Секреты и ключи (152-ФЗ, безопасность) ---
.env
.env.*
!.env.example
secrets/
*.pem
*.key
sa-key.json

# --- Локальное хранилище (SQLite) ---
data/
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo

# --- Логи (Zero-Storage Logging пишет только в stdout) ---
logs/
*.log

# --- Временные файлы ---
*.tmp
*.temp
tmp/
out/
