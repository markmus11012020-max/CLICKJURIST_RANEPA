# ==============================================================================
# ClickJurist Production — ПРИМЕР конфигурации окружения
#
# Как пользоваться:
#   1. Скопируйте файл в `.env` (он исключён из git через .gitignore).
#   2. Заполните реальные значения секретов.
#
# ⚠️ БЕЗОПАСНОСТЬ (152-ФЗ):
#   В production секреты НЕ хранятся в открытом `.env`. Они шифруются в
#   Yandex Key Management Service (KMS) и расшифровываются на старте приложения
#   (см. `backend/yandex_kms.py`, флаг YANDEX_KMS_ENABLED=true).
#   Для локальной разработки допустим plain `.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ПРИЛОЖЕНИЕ
# ------------------------------------------------------------------------------
APP_ENV=development                 # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000  # Базовый URL (ссылки возврата Robokassa)
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*                # через запятую: https://clickjurist.ru

# ------------------------------------------------------------------------------
# 2. 152-ФЗ: ИДЕНТИФИКАЦИЯ СЕССИИ (без персональных данных)
# ------------------------------------------------------------------------------
# Соль для хеширования связки "IP + отпечаток браузера".
# Сырые IP и отпечатки НИГДЕ не хранятся — только SHA-256 с этой солью.
SESSION_HASH_SALT=please-change-this-salt

# ------------------------------------------------------------------------------
# 3. ХРАНИЛИЩЕ (SQLite для разработки / PostgreSQL для production)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/clickjurist.db
# DATABASE_URL=postgresql://clickjurist:password@10.0.0.5:6432/clickjurist
FREE_TIER_REQUESTS=1                # Сколько запросов бесплатно

# ------------------------------------------------------------------------------
# 4. STAGE 1 — КОНТУР МАСКИРОВКИ ПЕРСОНАЛЬНЫХ ДАННЫХ (российский LLM)
# ------------------------------------------------------------------------------
# yandex — YandexGPT | ollama — локальный инстанс | regex — оффлайн-страховка
MASKING_PROVIDER=yandex

# -- YandexGPT (Yandex Foundation Models) --
YANDEX_GPT_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
YANDEX_API_KEY=                     # API-ключ сервисного аккаунта
YANDEX_IAM_TOKEN=                   # либо IAM-токен (живёт 12 часов)
YANDEX_FOLDER_ID=                   # folder_id в Yandex Cloud
YANDEX_GPT_MODEL=yandexgpt-lite     # yandexgpt-lite | yandexgpt
YANDEX_TIMEOUT_S=120

# -- Локальный Ollama (полностью изолированный контур) --
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_S=120

# ------------------------------------------------------------------------------
# 5. STAGE 2 — AITUNNEL (Gemini 2.5 Flash + web-инструменты)
# ------------------------------------------------------------------------------
ROUTER_API_KEY=sk-aitunnel-...
ROUTER_BASE_URL=https://api.aitunnel.ru/v1
MODEL_LLM_1=deepseek-v4-flash            # быстрый черновик (LLM-1: юрист)
MODEL_LLM_2=minimax-m3                   # асессор (LLM-2: эталон)
MODEL_GEMINI_FACTCHECK=gemini-2.5-flash  # внешняя проверка по веб-источникам
AITUNNEL_TIMEOUT_S=600
MAX_TOKENS_LLM_1=4000
MAX_TOKENS_LLM_2=6000

# ------------------------------------------------------------------------------
# 6. FAILOVER-ОРКЕСТРАТОР (устойчивость к падению внешних API)
# ------------------------------------------------------------------------------
PRIMARY_PROVIDER=aitunnel           # aitunnel | yandex  (роли переключаемы)

# ------------------------------------------------------------------------------
# 7. WEB-ФАКТЧЕКИНГ (от 2 до 3 независимых источников)
# ------------------------------------------------------------------------------
WEB_SEARCH_PROVIDER=none            # none | yandex | serper | tavily
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MIN_SOURCES=2
WEB_SEARCH_MAX_SOURCES=3
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_URL=https://searchapi.api.cloud.yandex.net/v2/web/search
SERPER_API_KEY=
SERPER_URL=https://google.serper.dev/search
TAVILY_API_KEY=
TAVILY_URL=https://api.tavily.com/search

# ------------------------------------------------------------------------------
# 8. YANDEX KEY MANAGEMENT SERVICE (шифрование секретов)
# ------------------------------------------------------------------------------
YANDEX_KMS_ENABLED=false
YANDEX_KMS_URL=https://kms.api.cloud.yandex.net/kms/v1/keys
YANDEX_KMS_KEY_ID=
YANDEX_KMS_CIPHERTEXT_FILE=secrets/kms-secrets.b64   # base64 от KMS Encrypt
YANDEX_KMS_REFRESH_INTERVAL_S=300

# ------------------------------------------------------------------------------
# 9. ZERO-STORAGE LOGGING (Yandex Cloud Logging)
# ------------------------------------------------------------------------------
YANDEX_LOGGING_ENABLED=false
YANDEX_LOGGING_URL=https://logging.api.cloud.yandex.net/logging/v1/entries:write
YANDEX_LOG_GROUP_ID=

# ------------------------------------------------------------------------------
# 10. ROBOKASSA (эквайринг, sandbox: test=1)
# ------------------------------------------------------------------------------
ROBOKASSA_LOGIN=clickjurist
ROBOKASSA_PASSWORD1=test_password_1
ROBOKASSA_PASSWORD2=test_password_2
ROBOKASSA_TEST=true
ROBOKASSA_PAYMENT_URL=https://auth.robokassa.ru/Merchant/Index.aspx
ROBOKASSA_HASH_ALGORITHM=md5        # md5 | sha256 (настраивается в ЛК Робокассы)
ROBOKASSA_SUCCESS_URL=/api/payment/success
ROBOKASSA_FAIL_URL=/api/payment/fail
ROBOKASSA_RESULT_URL=/api/payment/result

# ------------------------------------------------------------------------------
# 11. ТАРИФЫ (рубли)
# ------------------------------------------------------------------------------
PRICE_CONSULTATION=99
PRICE_CHECKLIST=100
PRICE_DOCUMENT=300

# ------------------------------------------------------------------------------
# 12. PDF (кириллица)
# ------------------------------------------------------------------------------
# Пустой = автопоиск (DejaVuSans / Arial). Явный путь имеет приоритет.
PDF_FONT_PATH=
